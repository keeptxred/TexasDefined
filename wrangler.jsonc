{
  // Cloudflare Workers runtime for TexasDefined.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "texasdefined-site",
  "main": "src/server-entry.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "CJ_PUBLISHER_ID": "8062457",
    "CJ_WEBSITE_ID": "101876465",
    "TICKETMASTER_IMPACT_BASE_URL": "https://ticketmaster.evyy.net/c/7758914/264167/4272?subId1=texasdefined&partnerpropertyid=8837726&MediaPartnerPropertyId=8837726"
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    {
      "binding": "TEXAS_DEFINED_AI_ANALYTICS",
      "dataset": "texas_defined_ai_questions"
    },
    {
      "binding": "TEXAS_DEFINED_OUTCOME_ANALYTICS",
      "dataset": "texas_defined_outcomes"
    }
  ],
  "ratelimits": [
    {
      "name": "TEXAS_DEFINED_AI_RATE_LIMITER",
      "namespace_id": "1651001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
