{
  // Cloudflare Workers runtime for TexasDefined.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "texasdefined-site",
  "main": "src/server-entry.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "KEEP_TX_RED_SUPABASE_URL": "https://ftkznprjljkhymknvhye.supabase.co"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "KEEP_TX_RED_SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "TEXAS_DEFINED_AI_RATE_LIMITER",
      "namespace_id": "1651001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
